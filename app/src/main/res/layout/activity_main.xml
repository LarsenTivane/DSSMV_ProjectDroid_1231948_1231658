<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/main"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="24dp"
              android:gravity="center_horizontal">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyMatch"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

    <Button
            android:id="@+id/btnCarregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consultar Grupos (API)"/>

    <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="16sp"
            android:text="Estado: A aguardar pedido..."
            android:layout_marginTop="16dp"/>

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="24dp"/>

    <TextView
            android:id="@+id/tvSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acelerómetro ativo: Agite o telemóvel para atualizar!"
            android:textAlignment="center"
            android:textSize="15sp"/>

</LinearLayout>