<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyMatch"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <Button
                android:id="@+id/btnCarregar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Atualizar" />

        <Button
                android:id="@+id/btnCriarVaga"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="+ Nova Vaga" />
    </LinearLayout>

    <!-- Indicador do Modo Foco (Sensor de Proximidade) -->
    <TextView
            android:id="@+id/tvFocusMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="6dp"
            android:background="#E0F2F1"
            android:textColor="#004D40"
            android:text="Mesa de Estudo: Telemóvel ativo"
            android:textAlignment="center"
            android:textSize="12sp" />

    <!-- Indicador de GPS / Distância ao Campus -->
    <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="6dp"
            android:background="#EDE7F6"
            android:textColor="#4527A0"
            android:text="📍 A calcular distância ao ISEP..."
            android:textAlignment="center"
            android:textSize="12sp" />

    <!-- Lista de Cartões -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStudyGroups"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />

    <TextView
            android:id="@+id/tvSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agite o telemóvel para atualizar"
            android:textAlignment="center"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

</LinearLayout>